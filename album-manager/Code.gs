const P=PropertiesService.getScriptProperties(),SID='ALBUM_MANAGER_SHEET_ID',PASS='ALBUM_MANAGER_ADMIN_PASSWORD';
function doGet(e){return HtmlService.createHtmlOutputFromFile(e&&e.parameter&&e.parameter.page==='client'?'Client':'Admin').setTitle('SARITA PHOTO Client Album Manager').addMetaTag('viewport','width=device-width,initial-scale=1');}
function setupAlbumManager(){let id=P.getProperty(SID),ss;try{ss=id?SpreadsheetApp.openById(id):null;}catch(e){}if(!ss){ss=SpreadsheetApp.create('SARITA PHOTO - Private Client Albums');P.setProperty(SID,ss.getId());}let s=ss.getSheetByName('Albums')||ss.insertSheet('Albums');if(!s.getLastRow()){s.appendRow(['Created At','Client Name','Mobile','Code SHA-256','Album URL','Status']);s.setFrozenRows(1);s.getRange(1,1,1,6).setFontWeight('bold');}return 'Setup complete: '+ss.getUrl()+'. Now set ALBUM_MANAGER_ADMIN_PASSWORD in Project Settings > Script properties.';}
function adminLogin(p){let expected=P.getProperty(PASS);if(!expected||expected.length<12)throw Error('Set ALBUM_MANAGER_ADMIN_PASSWORD in Script Properties (minimum 12 characters).');if(String(p||'')!==expected)throw Error('Incorrect password.');let t=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('album_admin_'+t,'ok',21600);return {token:t};}
function auth_(t){if(!t||CacheService.getScriptCache().get('album_admin_'+t)!=='ok')throw Error('Session expired. Sign in again.');}
function sheet_(){let id=P.getProperty(SID);if(!id)throw Error('Run setupAlbumManager() once from the editor.');return SpreadsheetApp.openById(id).getSheetByName('Albums');}
function listAlbums(t){auth_(t);return sheet_().getDataRange().getValues().slice(1).map((r,i)=>({row:i+2,created:r[0] instanceof Date?Utilities.formatDate(r[0],Session.getScriptTimeZone(),'dd MMM yyyy'):'',name:String(r[1]||''),phone:String(r[2]||''),url:String(r[4]||''),status:String(r[5]||'ACTIVE')})).filter(r=>r.name).reverse();}
function createAlbum(t,x){auth_(t);x=x||{};let name=String(x.name||'').trim().slice(0,100),phone=String(x.phone||'').replace(/\D/g,'').slice(-10),url=String(x.url||'').trim();if(!name)throw Error('Client name required.');if(!/^\d{10}$/.test(phone))throw Error('Enter a valid 10-digit mobile number.');if(!/^https:\/\/view\.ealbum\.in\/\?c=[A-Za-z0-9_-]+$/.test(url))throw Error('Use a valid link like https://view.ealbum.in/?c=YOURCODE');let c=code_();sheet_().appendRow([new Date(),name,phone,hash_(c),url,'ACTIVE']);return {name:name,phone:phone,code:c};}
function setAlbumStatus(t,row,status){auth_(t);row=Number(row);if(!Number.isInteger(row)||row<2||row>sheet_().getLastRow()||!['ACTIVE','DISABLED'].includes(status))throw Error('Invalid album/status.');sheet_().getRange(row,6).setValue(status);return {ok:true};}
function clientLogin(phone,code){phone=String(phone||'').replace(/\D/g,'').slice(-10);code=String(code||'').trim().toUpperCase();if(!/^\d{10}$/.test(phone)||! /^[A-Z0-9]{8}$/.test(code))throw Error('Check your 10-digit mobile and 8-character code.');let cache=CacheService.getScriptCache(),k='album_try_'+hash_(phone),n=Number(cache.get(k)||0);if(n>=8)throw Error('Too many attempts. Try again after 15 minutes.');let rows=sheet_().getDataRange().getValues(),h=hash_(code);for(let i=1;i<rows.length;i++){let r=rows[i];if(String(r[2])===phone&&String(r[3])===h&&String(r[5]||'ACTIVE')==='ACTIVE'){cache.remove(k);return {url:String(r[4]),name:String(r[1]||'Client')};}}cache.put(k,String(n+1),900);throw Error('Mobile number or code is incorrect, or access is disabled.');}
function code_(){let a='ABCDEFGHJKLMNPQRSTUVWXYZ23456789',s='';for(let i=0;i<8;i++)s+=a[Math.floor(Math.random()*a.length)];return s;}
function hash_(v){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(v),Utilities.Charset.UTF_8).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}